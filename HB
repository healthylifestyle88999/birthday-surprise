<!DOCTYPE html>
<html lang="en" translate="no">
<head>
<meta name="google" content="notranslate">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Eunie Birthday Universe</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js">
    // Personal birthday recording
    const bgmSong = document.getElementById("bgmSong");
    const myBirthdaySong = document.getElementById("myBirthdaySong");

    function playBirthdaySong(){
        if (typeof bgmSong !== "undefined") {
            bgmSong.pause();
        }

        myBirthdaySong.currentTime = 0;
        myBirthdaySong.play();

        myBirthdaySong.onended = function(){
            if (typeof bgmSong !== "undefined") {
                bgmSong.play().catch(()=>{});
            }
        };
    }


    // Background music unlock
    function startBackgroundMusic(){
        try {
            if (typeof bgmSong !== "undefined" && bgmSong) {
                bgmSong.loop = true;
                bgmSong.volume = 0.55;
                bgmSong.play().catch(()=>{});
            }
        } catch(e){}
    }

    document.addEventListener("click", startBackgroundMusic, {once:true});
    document.addEventListener("touchstart", startBackgroundMusic, {once:true});
    document.addEventListener("pointerdown", startBackgroundMusic, {once:true});
    

function forceHideEnterUniverse(){
    const overlay = document.getElementById("enterUniverse");
    if(overlay){
        overlay.style.opacity = "0";
        overlay.style.visibility = "hidden";
        overlay.style.pointerEvents = "none";
        setTimeout(()=>{
            overlay.remove();
        },600);
    }
}

</script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    :root {
      --glass: rgba(21, 18, 58, 0.55);
      --glass-border: rgba(190, 184, 255, 0.18);
      --purple: #a97cff;
      --pink: #ff9fe5;
      --cyan: #80e8ff;
      --gold: #ffd46a;
    }

    html,
    body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      color: #fff;
      background:
        radial-gradient(ellipse at 16% 18%, rgba(79, 59, 171, 0.46) 0%, rgba(31, 25, 95, 0.23) 24%, transparent 50%),
        radial-gradient(ellipse at 82% 20%, rgba(73, 26, 128, 0.38) 0%, rgba(31, 15, 79, 0.18) 28%, transparent 54%),
        radial-gradient(ellipse at 67% 78%, rgba(32, 97, 165, 0.30) 0%, rgba(20, 52, 109, 0.12) 30%, transparent 58%),
        radial-gradient(ellipse at 31% 82%, rgba(115, 39, 140, 0.24) 0%, transparent 48%),
        linear-gradient(135deg, #070922 0%, #100b32 37%, #160a34 66%, #071527 100%);
    }

    body::before,
    body::after {
      content: "";
      position: fixed;
      inset: -20%;
      pointer-events: none;
      z-index: 0;
      opacity: 0.55;
      filter: blur(46px);
      transform: scale(1.1);
    }

    body::before {
      background:
        radial-gradient(ellipse at 30% 38%, rgba(137, 87, 255, 0.22), transparent 30%),
        radial-gradient(ellipse at 66% 42%, rgba(239, 104, 255, 0.13), transparent 27%),
        radial-gradient(ellipse at 58% 70%, rgba(60, 169, 255, 0.14), transparent 34%);
      animation: nebulaDriftA 28s ease-in-out infinite alternate;
    }

    body::after {
      background:
        radial-gradient(ellipse at 42% 56%, rgba(97, 74, 205, 0.15), transparent 34%),
        radial-gradient(ellipse at 78% 65%, rgba(39, 111, 214, 0.14), transparent 30%);
      animation: nebulaDriftB 34s ease-in-out infinite alternate;
    }

    @keyframes nebulaDriftA {
      from { transform: translate3d(-1.5%, -0.8%, 0) scale(1.08) rotate(-1deg); }
      to   { transform: translate3d(1.8%, 1.2%, 0) scale(1.14) rotate(1deg); }
    }

    @keyframes nebulaDriftB {
      from { transform: translate3d(1%, 1.5%, 0) scale(1.06); }
      to   { transform: translate3d(-1.8%, -1%, 0) scale(1.12); }
    }

    #webglCanvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .view-section {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transition: opacity 0.9s ease, transform 0.9s ease, filter 0.9s ease;
    }

    .hidden {
      opacity: 0;
      pointer-events: none;
      transform: scale(0.988);
      filter: blur(3px);
    }

    /* ---------- 开场字幕 ---------- */
    #view1 {
      pointer-events: none;
      padding: 22px;
    }

    .pixel-matrix-text {
      width: min(92vw, 980px);
      text-align: center;
      font-size: clamp(38px, 7.2vw, 84px);
      line-height: 1.25;
      font-weight: 800;
      letter-spacing: 0.035em;
      color: #fff;
      text-wrap: balance;
      text-shadow:
        0 0 6px rgba(255,255,255,.95),
        0 0 18px rgba(200, 162, 255, .9),
        0 0 44px rgba(128, 90, 255, .58),
        0 0 78px rgba(91, 190, 255, .24);
      will-change: opacity, transform, filter;
    }

    .pixel-matrix-text.countdown {
      font-size: clamp(74px, 15vw, 150px);
      font-family: "Courier New", Courier, monospace;
      font-weight: 900;
    }

    .line-enter {
      animation: lineFade var(--line-duration, 2000ms) ease-in-out both;
    }

    @keyframes lineFade {
      0%   { opacity: 0; transform: scale(.95); filter: blur(4px); }
      13%  { opacity: 1; transform: scale(1); filter: blur(0); }
      79%  { opacity: 1; transform: scale(1); filter: blur(0); }
      100% { opacity: 0; transform: scale(1.025); filter: blur(2px); }
    }

    /* ---------- 蛋糕页 ---------- */
    #view2 {
      justify-content: flex-start;
      padding: clamp(30px, 5.8vh, 62px) 20px 28px;
      text-align: center;
      background:
        linear-gradient(180deg, rgba(5, 7, 30, .02), rgba(5, 7, 30, .13) 56%, rgba(5, 7, 30, .28));
    }

    .birthday-title {
      z-index: 3;
      font-size: clamp(48px, 11vw, 90px);
      line-height: .86;
      font-weight: 700;
      color: #bdeaff;
      font-family: "Brush Script MT", "Segoe Script", "Comic Sans MS", cursive;
      letter-spacing: -1px;
      text-shadow:
        0 0 10px rgba(193, 239, 255, .65),
        0 0 30px rgba(88, 187, 255, .32),
        0 0 64px rgba(98, 109, 255, .2);
      transform: rotate(-1.6deg);
    }

    .cake-spacer {
      flex: 1;
      min-height: 250px;
      width: 100%;
    }

    .wish-panel {
      width: min(460px, calc(100vw - 40px));
      z-index: 4;
    }

    .wish-btn {
      width: 100%;
      min-height: 66px;
      border: 1px solid rgba(180, 230, 255, .28);
      border-radius: 999px;
      padding: 0 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 13px;
      color: #fff0ab;
      font-size: clamp(14px, 3.6vw, 19px);
      font-weight: 800;
      letter-spacing: .07em;
      background:
        linear-gradient(90deg, rgba(52, 78, 210, .9), rgba(23, 136, 217, .88)),
        rgba(34, 42, 100, .8);
      box-shadow:
        0 16px 36px rgba(0, 82, 210, .22),
        0 0 26px rgba(88, 197, 255, .12),
        inset 0 1px 0 rgba(255,255,255,.2);
      backdrop-filter: blur(12px);
      cursor: pointer;
      transition: transform .18s ease, filter .18s ease, box-shadow .18s ease;
    }

    .wish-btn:hover { filter: brightness(1.08); }
    .wish-btn:active { transform: scale(.975); }

    .wish-btn .icon {
      width: 34px;
      height: 34px;
      flex: 0 0 34px;
      border: 1px solid rgba(255,255,255,.75);
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 16px;
      box-shadow: 0 0 16px rgba(139, 227, 255, .25);
    }

    .wish-note {
      margin-top: 10px;
      color: rgba(224, 236, 255, .58);
      font-size: 11px;
      letter-spacing: .04em;
    }

    /* ---------- 盲盒宇宙 ---------- */
    #view3 {
      overflow-y: auto;
      padding: 26px 12px;
      justify-content: flex-start;
      background:
        radial-gradient(ellipse at 18% 10%, rgba(102, 75, 215, .24), transparent 34%),
        radial-gradient(ellipse at 88% 28%, rgba(94, 43, 168, .22), transparent 30%),
        radial-gradient(ellipse at 52% 88%, rgba(40, 126, 196, .17), transparent 37%),
        linear-gradient(180deg, rgba(8, 8, 34, .26), rgba(13, 10, 43, .5));
    }

    #view3::before,
    #view3::after {
      content: "";
      position: fixed;
      pointer-events: none;
      border-radius: 50%;
      filter: blur(50px);
      z-index: -1;
      opacity: .75;
    }

    #view3::before {
      width: 44vw;
      height: 44vw;
      left: -12vw;
      top: 16vh;
      background: rgba(111, 76, 255, .14);
    }

    #view3::after {
      width: 42vw;
      height: 42vw;
      right: -14vw;
      bottom: 7vh;
      background: rgba(27, 145, 211, .11);
    }

    .card-container {
      position: relative;
      width: min(430px, 100%);
      margin: auto 0;
      padding: 24px 18px 20px;
      border-radius: 28px;
      text-align: center;
      color: white;
      background:
        linear-gradient(180deg, rgba(31, 27, 75, .68), rgba(18, 20, 58, .58));
      border: 1px solid rgba(196, 201, 255, .18);
      box-shadow:
        0 22px 60px rgba(2, 2, 20, .34),
        0 0 50px rgba(124, 92, 255, .10),
        inset 0 1px 0 rgba(255,255,255,.08);
      backdrop-filter: blur(18px) saturate(125%);
      overflow: hidden;
    }

    .card-container::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(circle at 10% 12%, rgba(255,255,255,.55) 0 1px, transparent 1.6px),
        radial-gradient(circle at 72% 16%, rgba(189,213,255,.45) 0 1px, transparent 1.5px),
        radial-gradient(circle at 90% 55%, rgba(255,224,173,.45) 0 1px, transparent 1.5px),
        radial-gradient(circle at 16% 76%, rgba(210,184,255,.45) 0 1px, transparent 1.5px);
      background-size: 92px 92px, 127px 127px, 149px 149px, 171px 171px;
      opacity: .55;
    }

    .header-title,
    .sub-title,
    .chances-bar,
    .grid,
    .inventory-sec,
    .restart-btn {
      position: relative;
      z-index: 1;
    }

    .header-title {
      font-size: 23px;
      font-weight: 850;
      color: #f0c4ff;
      text-shadow: 0 0 20px rgba(203, 125, 255, .28);
      margin-bottom: 5px;
    }

    .sub-title {
      font-size: 12px;
      color: rgba(207, 215, 255, .72);
      margin-bottom: 20px;
    }

    .chances-bar {
      background: rgba(255,255,255,.065);
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 18px;
      padding: 9px 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
    }

    .chances-text {
      white-space: nowrap;
      font-size: 13px;
      color: rgba(243, 239, 255, .88);
      font-weight: 750;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      margin-left: 3px;
      border-radius: 50%;
      color: #fff;
      background: linear-gradient(135deg, #d967ff, #735fff);
      box-shadow: 0 0 16px rgba(190, 100, 255, .35);
      font-size: 12px;
    }

    .progress-track {
      flex: 1;
      height: 7px;
      border-radius: 999px;
      background: rgba(255,255,255,.1);
      overflow: hidden;
    }

    .progress-fill {
      width: 100%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #bb78ff, #6cc8ff);
      box-shadow: 0 0 12px rgba(133, 168, 255, .4);
      transition: width .32s ease;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 13px;
      margin-bottom: 18px;
    }

    .box-card {
      min-height: 148px;
      position: relative;
      padding: 14px 12px 13px;
      border-radius: 20px;
      border: 1px solid rgba(184, 193, 255, .15);
      background:
        radial-gradient(circle at 50% 35%, rgba(121, 102, 255, .15), transparent 54%),
        linear-gradient(180deg, rgba(255,255,255,.075), rgba(255,255,255,.035));
      box-shadow: inset 0 1px 0 rgba(255,255,255,.05);
      cursor: pointer;
      transition: transform .18s ease, opacity .2s ease, border-color .2s ease, background .2s ease;
    }

    .box-card:hover {
      transform: translateY(-2px);
      border-color: rgba(194, 164, 255, .35);
    }

    .box-card:active { transform: scale(.975); }

    .box-card.opened {
      cursor: default;
      opacity: .52;
      border-color: rgba(138, 222, 255, .22);
      background: rgba(87, 101, 149, .10);
      transform: none;
    }

    .box-card.locked:not(.opened) {
      cursor: default;
      opacity: .38;
    }

    .box-num {
      text-align: left;
      font-size: 11px;
      color: rgba(205, 189, 255, .76);
      font-weight: 800;
      letter-spacing: .08em;
    }

    .box-img {
      font-size: 45px;
      margin: 8px 0 7px;
      filter: drop-shadow(0 0 12px rgba(219, 157, 255, .16));
    }

    .open-btn {
      border: 1px solid rgba(255,255,255,.12);
      color: #fff;
      border-radius: 999px;
      padding: 6px 15px;
      font-size: 11px;
      font-weight: 800;
      background: linear-gradient(90deg, rgba(193, 87, 255, .86), rgba(102, 91, 255, .86));
      box-shadow: 0 0 16px rgba(164, 94, 255, .14);
      pointer-events: none;
    }

    .box-card.opened .open-btn {
      background: rgba(108, 214, 255, .12);
      color: rgba(224, 246, 255, .85);
    }

    .inventory-sec {
      text-align: left;
      border-radius: 16px;
      padding: 12px;
      margin-bottom: 14px;
      background: rgba(7, 8, 29, .24);
      border: 1px solid rgba(255,255,255,.055);
    }

    .sec-title {
      margin-bottom: 8px;
      color: rgba(188, 194, 255, .76);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .05em;
    }

    .inventory-list {
      display: flex;
      gap: 9px;
    }

    .slot {
      width: 48px;
      height: 48px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 13px;
      font-size: 21px;
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.055);
    }

    .slot .dot {
      position: absolute;
      top: -2px;
      right: -2px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #ff748d;
      box-shadow: 0 0 8px rgba(255, 86, 120, .62);
    }

    .restart-btn {
      width: 100%;
      padding: 12px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 15px;
      color: rgba(245, 244, 255, .92);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: .04em;
      cursor: pointer;
      background: rgba(255,255,255,.065);
      transition: background .2s ease, transform .18s ease;
    }

    .restart-btn:hover { background: rgba(255,255,255,.11); }
    .restart-btn:active { transform: scale(.985); }

    /* ---------- Modal ---------- */
    .modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(3, 4, 20, .64);
      backdrop-filter: blur(9px);
    }

    .modal {
      width: min(340px, 100%);
      max-height: 88vh;
      overflow-y: auto;
      border-radius: 25px;
      padding: 23px 20px 20px;
      text-align: center;
      color: #fff;
      border: 1px solid rgba(196, 137, 255, .35);
      background:
        radial-gradient(circle at 50% 0%, rgba(126, 93, 255, .18), transparent 42%),
        linear-gradient(180deg, rgba(30, 24, 71, .96), rgba(18, 17, 53, .96));
      box-shadow: 0 22px 70px rgba(0,0,0,.42), 0 0 42px rgba(132, 89, 255, .12);
      animation: modalPop .28s ease-out;
    }

    @keyframes modalPop {
      from { transform: translateY(10px) scale(.94); opacity: 0; }
      to   { transform: translateY(0) scale(1); opacity: 1; }
    }

    .modal-icon {
      font-size: 42px;
      margin-bottom: 8px;
    }

    .modal-title {
      margin-bottom: 12px;
      color: #efc6ff;
      font-size: 18px;
      font-weight: 850;
    }

    .modal-copy {
      font-size: 12px;
      line-height: 1.6;
      color: rgba(216, 220, 255, .75);
      margin-bottom: 12px;
    }

    .form-group {
      text-align: left;
      margin-bottom: 10px;
    }

    .form-group label {
      display: block;
      margin-bottom: 4px;
      color: rgba(194, 196, 255, .75);
      font-size: 11px;
      font-weight: 700;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      padding: 10px 11px;
      border: 1px solid rgba(152, 136, 255, .32);
      border-radius: 10px;
      outline: none;
      color: #fff;
      background: rgba(255,255,255,.065);
      font-size: 12px;
    }

    .form-group select option { color: #111; }

    .action-btn {
      width: 100%;
      margin-top: 10px;
      padding: 12px;
      border: 0;
      border-radius: 999px;
      color: #fff;
      font-size: 13px;
      font-weight: 850;
      cursor: pointer;
      background: linear-gradient(90deg, #c65dff, #655fff);
      box-shadow: 0 8px 24px rgba(117, 78, 255, .2);
    }

    .secondary-btn {
      width: 100%;
      margin-top: 8px;
      padding: 10px;
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 999px;
      color: rgba(238, 238, 255, .8);
      background: rgba(255,255,255,.04);
      cursor: pointer;
    }

    /* ---------- Virtual Kiss 全屏 ---------- */
    #kissLayer {
      position: fixed;
      inset: 0;
      z-index: 150;
      pointer-events: none;
      overflow: hidden;
      display: none;
    }

    .kiss-particle {
      position: absolute;
      font-size: var(--kiss-size, 17px);
      opacity: 0;
      filter: drop-shadow(0 0 7px rgba(255, 100, 167, .25));
      animation: kissBloom var(--kiss-duration, 3000ms) ease-out forwards;
      animation-delay: var(--kiss-delay, 0ms);
      will-change: transform, opacity;
    }

    @keyframes kissBloom {
      0% {
        opacity: 0;
        transform: translate3d(0, 24px, 0) scale(.45) rotate(var(--kiss-rot, 0deg));
      }
      16% { opacity: .95; }
      72% { opacity: .88; }
      100% {
        opacity: 0;
        transform: translate3d(var(--kiss-dx, 0px), -52px, 0) scale(1.2) rotate(calc(var(--kiss-rot, 0deg) + 16deg));
      }
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: 28px;
      z-index: 180;
      transform: translateX(-50%) translateY(16px);
      opacity: 0;
      max-width: min(86vw, 420px);
      padding: 10px 15px;
      border-radius: 999px;
      color: #fff;
      text-align: center;
      font-size: 12px;
      background: rgba(25, 22, 65, .88);
      border: 1px solid rgba(196, 183, 255, .2);
      backdrop-filter: blur(12px);
      pointer-events: none;
      transition: opacity .25s ease, transform .25s ease;
    }

    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    @media (max-height: 680px) {
      .birthday-title { font-size: clamp(42px, 10vw, 72px); }
      .cake-spacer { min-height: 190px; }
      #view2 { padding-top: 22px; }
    }
  </style>
</head>
<body>
  <audio id="bgmSong" src="data:audio/mp4;base64,"></audio>

<audio id="myBirthdaySong" src="data:audio/mp4;base64,"></audio>

<audio id="bgm" loop src="https://cdn.pixabay.com/download/audio/2022/03/15/audio_c8c8a73562.mp3?filename=happy-birthday-152028.mp3"></audio>

  
<div id="enterUniverse" translate="no" style="
position:fixed;
inset:0;
z-index:9999;
display:flex;
align-items:center;
justify-content:center;
background:radial-gradient(circle,#302060,#050008);
color:white;
font-size:28px;
font-weight:700;
letter-spacing:2px;
cursor:pointer;
font-family:Arial,sans-serif;
">
✨ Tap to Enter Universe ✨
</div>

<canvas id="webglCanvas"></canvas>

  <section id="view1" class="view-section">
    <div id="displayText" translate="no" class="pixel-matrix-text countdown">3</div>
  </section>

  <section id="view2" class="view-section hidden">
    <div class="birthday-title">Happy<br />Birthday!</div>
    <div class="cake-spacer"></div>
    <div class="wish-panel">
      <button id="wishBtn" translate="no" class="wish-btn" type="button" onclick="handleWishButton()">
        <span class="icon">✦</span>
        <span id="wishBtnText">BLOW &amp; MAKE A WISH</span>
      </button>
      <div class="wish-note" id="wishNote">轻触按钮吹灭 8 根蜡烛 ✨</div>
    </div>
  </section>

  <section id="view3" class="view-section hidden">
    <div class="card-container">
      <div class="header-title">🎂 生日奇妙盲盒屋</div>
      <div class="sub-title">Choose any THREE mystery gift boxes.</div>

      <div class="chances-bar">
        <div class="chances-text">Chances Left <span class="badge" id="chanceNum">3</span></div>
        <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
      </div>

      <div class="grid" id="boxGrid">
        <div class="box-card" data-box="1" onclick="openBox(1)">
          <div class="box-num">#01</div>
          <div class="box-img">🎁</div>
          <button class="open-btn" type="button">OPEN</button>
        </div>
        <div class="box-card" data-box="2" onclick="openBox(2)">
          <div class="box-num">#02</div>
          <div class="box-img">🎁</div>
          <button class="open-btn" type="button">OPEN</button>
        </div>
        <div class="box-card" data-box="3" onclick="openBox(3)">
          <div class="box-num">#03</div>
          <div class="box-img">🎁</div>
          <button class="open-btn" type="button">OPEN</button>
        </div>
        <div class="box-card" data-box="4" onclick="openBox(4)">
          <div class="box-num">#04</div>
          <div class="box-img">🎁</div>
          <button class="open-btn" type="button">OPEN</button>
        </div>
      </div>

      <div class="inventory-sec">
        <div class="sec-title">✨ YOUR SURPRISES</div>
        <div class="inventory-list" id="inventoryList">
          <div class="slot">🎤</div>
          <div class="slot">🧋</div>
          <div class="slot">💋</div>
          <div class="slot">💫</div>
        </div>
      </div>

      <button class="restart-btn" type="button" onclick="resetGame()">RESTART GAME</button>
    </div>
  </section>

  <div class="modal-overlay" id="modalOverlay" onclick="overlayClose(event)">
    <div class="modal" id="modalContent"></div>
  </div>

  <div id="kissLayer"></div>
  <div id="toast" class="toast"></div>

  <script>
    /* =========================================================
       CONFIG
       ========================================================= */
    // 要实现 Gift & Submit 后真正寄信，请把这里改成你的收件邮箱。
    // 目前留空时会提示你补上邮箱，不会假装已经寄出。
    const GIFT_RECEIVER_EMAIL = "eunistey@gmail.com";

    /* =========================================================
       THREE.JS — 深紫蓝宇宙 + 星尘雾气 + 慢速漂浮
       ========================================================= */
    const canvas = document.getElementById("webglCanvas");
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x080b24, 0.015);

    const camera = new THREE.PerspectiveCamera(
      58,
      window.innerWidth / window.innerHeight,
      0.1,
      1000
    );
    camera.position.set(0, 0.15, 10.8);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: "high-performance"
    });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(0x000000, 0);

    function makeNebulaTexture(colors) {
      const size = 512;
      const c = document.createElement("canvas");
      c.width = c.height = size;
      const ctx = c.getContext("2d");
      const g = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
      g.addColorStop(0, colors[0]);
      g.addColorStop(.28, colors[1]);
      g.addColorStop(.62, colors[2]);
      g.addColorStop(1, "rgba(0,0,0,0)");
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, size, size);
      return new THREE.CanvasTexture(c);
    }

    const nebulaGroup = new THREE.Group();
    const nebulaSpecs = [
      { p: [-4.6,  2.8, -5.5], s: [9.5, 5.6, 1], c: ["rgba(145,91,255,.58)", "rgba(91,64,211,.28)", "rgba(27,18,92,.05)"] },
      { p: [ 4.8,  2.1, -6.6], s: [8.8, 5.0, 1], c: ["rgba(205,86,255,.35)", "rgba(90,49,166,.22)", "rgba(21,10,70,.04)"] },
      { p: [ 2.9, -3.2, -6.0], s: [9.0, 5.5, 1], c: ["rgba(57,172,255,.34)", "rgba(37,88,190,.20)", "rgba(13,32,90,.04)"] },
      { p: [-3.7, -3.1, -7.0], s: [7.5, 4.5, 1], c: ["rgba(164,67,197,.25)", "rgba(82,35,130,.14)", "rgba(15,11,64,.02)"] }
    ];

    nebulaSpecs.forEach((spec, i) => {
      const mat = new THREE.SpriteMaterial({
        map: makeNebulaTexture(spec.c),
        transparent: true,
        opacity: .62,
        depthWrite: false,
        blending: THREE.AdditiveBlending
      });
      const spr = new THREE.Sprite(mat);
      spr.position.set(...spec.p);
      spr.scale.set(...spec.s);
      spr.userData.baseY = spec.p[1];
      spr.userData.phase = i * 1.9;
      nebulaGroup.add(spr);
    });
    scene.add(nebulaGroup);

    // 星空铺满整个画面，不再只看到一个粒子球。
    function createStarField(count, size, opacity) {
      const geo = new THREE.BufferGeometry();
      const pos = new Float32Array(count * 3);
      const col = new Float32Array(count * 3);

      const palette = [
        new THREE.Color(0xeaf7ff),
        new THREE.Color(0xb8c8ff),
        new THREE.Color(0xd8b8ff),
        new THREE.Color(0xffddb0)
      ];

      for (let i = 0; i < count; i++) {
        const r = 9 + Math.random() * 29;
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(2 * Math.random() - 1);

        pos[i * 3] = Math.sin(phi) * Math.cos(theta) * r;
        pos[i * 3 + 1] = Math.sin(phi) * Math.sin(theta) * r;
        pos[i * 3 + 2] = Math.cos(phi) * r - 4;

        const c = palette[Math.floor(Math.random() * palette.length)].clone();
        const b = .58 + Math.random() * .42;
        col[i * 3] = c.r * b;
        col[i * 3 + 1] = c.g * b;
        col[i * 3 + 2] = c.b * b;
      }

      geo.setAttribute("position", new THREE.BufferAttribute(pos, 3));
      geo.setAttribute("color", new THREE.BufferAttribute(col, 3));

      const mat = new THREE.PointsMaterial({
        size,
        vertexColors: true,
        transparent: true,
        opacity,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        sizeAttenuation: true
      });

      return new THREE.Points(geo, mat);
    }

    const farStars = createStarField(4200, 0.024, 0.72);
    const nearStars = createStarField(1500, 0.042, 0.78);
    scene.add(farStars, nearStars);

    // 开场紫金星球与宽粒子环
    const universeGroup = new THREE.Group();
    universeGroup.rotation.x = -0.05;
    universeGroup.rotation.z = -0.12;

    const purple1 = new THREE.Color(0xb66cff);
    const purple2 = new THREE.Color(0x724fff);
    const pink = new THREE.Color(0xff91d9);
    const gold = new THREE.Color(0xffd99a);

    function createParticleSphere(count, radius) {
      const geo = new THREE.BufferGeometry();
      const positions = new Float32Array(count * 3);
      const colors = new Float32Array(count * 3);

      for (let i = 0; i < count; i++) {
        const u = Math.random();
        const v = Math.random();
        const theta = u * Math.PI * 2;
        const phi = Math.acos(2 * v - 1);
        const r = radius + (Math.random() - .5) * .32;

        positions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
        positions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
        positions[i * 3 + 2] = r * Math.cos(phi);

        const pick = Math.random();
        let c;
        if (pick < .58) c = purple1.clone().lerp(purple2, Math.random());
        else if (pick < .82) c = pink.clone().lerp(purple1, Math.random() * .45);
        else c = gold.clone();

        const b = .66 + Math.random() * .34;
        colors[i * 3] = c.r * b;
        colors[i * 3 + 1] = c.g * b;
        colors[i * 3 + 2] = c.b * b;
      }

      geo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
      geo.setAttribute("color", new THREE.BufferAttribute(colors, 3));

      const mat = new THREE.PointsMaterial({
        size: .03,
        vertexColors: true,
        transparent: true,
        opacity: .94,
        depthWrite: false,
        blending: THREE.AdditiveBlending
      });

      return new THREE.Points(geo, mat);
    }

    function createParticleRing(count) {
      const geo = new THREE.BufferGeometry();
      const positions = new Float32Array(count * 3);
      const colors = new Float32Array(count * 3);

      for (let i = 0; i < count; i++) {
        const radius = 3.1 + Math.pow(Math.random(), .8) * 5.5;
        const angle = Math.random() * Math.PI * 2;
        const spread = (Math.random() - .5) * (.20 + radius * .05);
        const wave = Math.sin(angle * 2.4) * .05;

        positions[i * 3] = Math.cos(angle) * radius;
        positions[i * 3 + 1] = spread + wave;
        positions[i * 3 + 2] = Math.sin(angle) * radius;

        const pick = Math.random();
        let c;
        if (pick < .55) c = purple1.clone().lerp(purple2, Math.random());
        else if (pick < .78) c = pink.clone();
        else c = gold.clone();

        const fade = .55 + Math.random() * .45;
        colors[i * 3] = c.r * fade;
        colors[i * 3 + 1] = c.g * fade;
        colors[i * 3 + 2] = c.b * fade;
      }

      geo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
      geo.setAttribute("color", new THREE.BufferAttribute(colors, 3));

      const mat = new THREE.PointsMaterial({
        size: .026,
        vertexColors: true,
        transparent: true,
        opacity: .82,
        depthWrite: false,
        blending: THREE.AdditiveBlending
      });

      const points = new THREE.Points(geo, mat);
      points.rotation.x = .43;
      points.rotation.z = -.08;
      return points;
    }

    universeGroup.add(createParticleSphere(36000, 2.48));
    universeGroup.add(createParticleRing(44000));
    scene.add(universeGroup);

    /* =========================================================
       参考图风格：蓝白粒子三层圆形蛋糕 + 8 根蜡烛
       ========================================================= */
    const cakeGroup = new THREE.Group();

    function makePointCloud(positions, colorHex, size, opacity = .95) {
      const geo = new THREE.BufferGeometry();
      geo.setAttribute("position", new THREE.Float32BufferAttribute(positions, 3));
      const mat = new THREE.PointsMaterial({
        color: colorHex,
        size,
        transparent: true,
        opacity,
        depthWrite: false,
        blending: THREE.AdditiveBlending
      });
      return new THREE.Points(geo, mat);
    }

    function createDenseCakeLayer(radius, height, yCenter, colorHex, count, pointSize) {
      const p = [];
      const sideCount = Math.floor(count * .61);
      const topCount = count - sideCount;

      for (let i = 0; i < sideCount; i++) {
        const a = Math.random() * Math.PI * 2;
        const y = yCenter + (Math.random() - .5) * height;
        const rr = radius + (Math.random() - .5) * .035;
        p.push(Math.cos(a) * rr, y, Math.sin(a) * rr);
      }

      const topY = yCenter + height / 2;
      for (let i = 0; i < topCount; i++) {
        const a = Math.random() * Math.PI * 2;
        const rr = Math.sqrt(Math.random()) * radius;
        p.push(Math.cos(a) * rr, topY + (Math.random() - .5) * .025, Math.sin(a) * rr);
      }

      return makePointCloud(p, colorHex, pointSize, .97);
    }

    function createCakeDrips(radius, topY, colorHex, strands, pointSize) {
      const p = [];
      for (let i = 0; i < strands; i++) {
        const a = Math.PI * (.06 + Math.random() * .88); // 主要放在镜头看得到的前半圈
        const x = Math.cos(a) * radius;
        const z = Math.sin(a) * radius;
        const len = .13 + Math.pow(Math.random(), 1.7) * .63;
        const dots = 5 + Math.floor(Math.random() * 16);
        for (let d = 0; d < dots; d++) {
          const t = d / Math.max(1, dots - 1);
          p.push(
            x + (Math.random() - .5) * .016,
            topY - t * len,
            z + (Math.random() - .5) * .016
          );
        }
      }
      return makePointCloud(p, colorHex, pointSize, .86);
    }

    const layer1 = { r: 2.42, h: .76, y: -1.14, c: 0x77dfff, n: 7600, s: .036 };
    const layer2 = { r: 1.78, h: .72, y: -.40, c: 0xa0edff, n: 5900, s: .035 };
    const layer3 = { r: 1.10, h: .65, y: .28, c: 0xd6f8ff, n: 4300, s: .034 };

    [layer1, layer2, layer3].forEach((L, idx) => {
      cakeGroup.add(createDenseCakeLayer(L.r, L.h, L.y, L.c, L.n, L.s));
      cakeGroup.add(createCakeDrips(L.r * .98, L.y + L.h / 2, idx === 0 ? 0x8de8ff : 0xc3f5ff, idx === 0 ? 118 : 88, .026));
    });

    // 顶部与轮廓的微光环，让三层圆形更清楚。
    function createGlowRing(radius, y, color) {
      const curve = new THREE.EllipseCurve(0, 0, radius, radius, 0, Math.PI * 2, false, 0);
      const pts2 = curve.getPoints(210);
      const positions = [];
      pts2.forEach(v => positions.push(v.x, y, v.y));
      return makePointCloud(positions, color, .045, .9);
    }

    cakeGroup.add(createGlowRing(layer1.r, layer1.y + layer1.h / 2, 0xa8efff));
    cakeGroup.add(createGlowRing(layer2.r, layer2.y + layer2.h / 2, 0xc9f6ff));
    cakeGroup.add(createGlowRing(layer3.r, layer3.y + layer3.h / 2, 0xebfdff));

    // 8 根蜡烛，分成前后两排，全部有发光火焰。
    const flameObjects = [];
    const candlePositions = [
      [-.76,  .72, -.10],
      [-.50,  .74,  .22],
      [-.26,  .72, -.02],
      [ 0.00,  .74,  .25],
      [ .26,  .72, -.02],
      [ .50,  .74,  .22],
      [ .76,  .72, -.10],
      [ 0.00,  .74, -.32]
    ];

    candlePositions.forEach((pos, idx) => {
      const candleGeo = new THREE.CylinderGeometry(.045, .045, .48, 8, 7, true);
      const candleMat = new THREE.PointsMaterial({
        color: idx % 2 ? 0xb7efff : 0xf2fdff,
        size: .029,
        transparent: true,
        opacity: .97,
        blending: THREE.AdditiveBlending,
        depthWrite: false
      });
      const candle = new THREE.Points(candleGeo, candleMat);
      candle.position.set(pos[0], pos[1], pos[2]);
      cakeGroup.add(candle);

      const flameGeo = new THREE.SphereGeometry(.095, 13, 9);
      const flameMat = new THREE.PointsMaterial({
        color: idx % 2 ? 0xff8f28 : 0xffd04d,
        size: .048,
        transparent: true,
        opacity: .98,
        blending: THREE.AdditiveBlending,
        depthWrite: false
      });
      const flame = new THREE.Points(flameGeo, flameMat);
      flame.scale.set(.72, 1.45, .72);
      flame.position.set(pos[0], pos[1] + .37, pos[2]);
      cakeGroup.add(flame);

      const glow = new THREE.PointLight(0xffb63a, .20, 1.25, 2);
      glow.position.set(pos[0], pos[1] + .36, pos[2] + .02);
      cakeGroup.add(glow);

      flameObjects.push({ flame, glow });
    });

    cakeGroup.position.set(0, -.47, 0);
    cakeGroup.scale.set(.85, .85, .85);
    cakeGroup.rotation.x = -.08;
    cakeGroup.visible = false;
    scene.add(cakeGroup);

    // 蛋糕页星星可见度略提亮。
    const cakeStarHalo = createStarField(850, .032, .72);
    cakeStarHalo.visible = false;
    scene.add(cakeStarHalo);

    const clock = new THREE.Clock();
    const UNIVERSE_TURN_SECONDS = 82; // 很慢，不会像之前那样晕

    function animate() {
      requestAnimationFrame(animate);
      const dt = Math.min(clock.getDelta(), .05);
      const t = performance.now() * .001;

      farStars.rotation.y += dt * .0025;
      nearStars.rotation.y -= dt * .003;

      nebulaGroup.children.forEach((spr, i) => {
        spr.position.y = spr.userData.baseY + Math.sin(t * .18 + spr.userData.phase) * .12;
      });

      if (universeGroup.visible) {
        universeGroup.rotation.y += (Math.PI * 2 / UNIVERSE_TURN_SECONDS) * dt;
        universeGroup.position.y = Math.sin(t * .22) * .08;
        universeGroup.position.x = Math.cos(t * .15) * .05;
      }

      if (cakeGroup.visible) {
        // 蛋糕几乎静止，只做轻微漂浮，不让人头晕。
        cakeGroup.position.y = -.47 + Math.sin(t * .7) * .035;
        cakeGroup.rotation.y = Math.sin(t * .16) * .035;

        flameObjects.forEach(({ flame, glow }, i) => {
          if (!flame.visible) return;
          const s = 1 + Math.sin(t * 6 + i * .7) * .065;
          flame.scale.set(.72 * s, 1.45 * s, .72 * s);
          glow.intensity = .17 + Math.sin(t * 7 + i) * .035;
        });
      }

      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener("resize", () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    /* =========================================================
       开场字幕时间：
       3 / 2 / 1 各 1 秒
       Hi benben / 两句祝福 各 2 秒
       生日快乐 3 秒并慢慢消失
       全自动，无需点击
       ========================================================= */
    const textSequence = [
      { text: "3", duration: 1000, countdown: true },
      { text: "2", duration: 1000, countdown: true },
      { text: "1", duration: 1000, countdown: true },
      { text: "Hi benben", duration: 2000 },
      { text: "愿你成为自己的太阳", duration: 2000 },
      { text: "活出自己理想的模样", duration: 2000 },
      { text: "生日快乐", duration: 4000 }
    ];

    const displayText = document.getElementById("displayText");
    const bgm = document.getElementById("bgm");
    let textIndex = 0;

    function playTextLine() {
      if (textIndex >= textSequence.length) {
        document.getElementById("view1").classList.add("hidden");
        setTimeout(showCakeView, 720);
        return;
      }

      const item = textSequence[textIndex];
      displayText.textContent = item.text;
      displayText.classList.toggle("countdown", !!item.countdown);
      displayText.style.setProperty("--line-duration", item.duration + "ms");

      displayText.classList.remove("line-enter");
      void displayText.offsetWidth;
      displayText.classList.add("line-enter");

      textIndex += 1;
      setTimeout(playTextLine, item.duration);
    }

    function showCakeView() {
      universeGroup.visible = false;
      cakeGroup.visible = true;
      cakeStarHalo.visible = true;
      document.getElementById("view2").classList.remove("hidden");
    }

    playTextLine();

    // 浏览器通常限制音频自动播放；第一次触摸页面后尝试播放。
    const tryPlayMusic = () => {
      if (bgm.paused) bgm.play().catch(() => {});
    };
    window.addEventListener("pointerdown", tryPlayMusic, { once: true });

    /* =========================================================
       蛋糕按钮：第一次吹灭 8 根蜡烛；第二次进入盲盒
       ========================================================= */
    let wishMade = false;

    function handleWishButton() {
      const btnText = document.getElementById("wishBtnText");
      const note = document.getElementById("wishNote");

      if (!wishMade) {
        wishMade = true;

        flameObjects.forEach(({ flame, glow }, index) => {
          setTimeout(() => {
            flame.visible = false;
            glow.visible = false;
          }, index * 85);
        });

        btnText.textContent = "WISH MADE ✨";
        note.textContent = "愿望已经收好 💙";

        setTimeout(() => {
          btnText.textContent = "OPEN YOUR BIRTHDAY SURPRISE";
          note.textContent = "轻触进入生日奇妙盲盒屋 🎁";
        }, 1250);
      } else {
        enterBlindBox();
      }
    }

    function enterBlindBox() {
      bgm.pause();
      bgm.currentTime = 0;
      document.getElementById("view2").classList.add("hidden");

      setTimeout(() => {
        cakeGroup.visible = false;
        cakeStarHalo.visible = false;
        // 保留全屏宇宙星空，盲盒页不再是黑底。
        document.getElementById("view3").classList.remove("hidden");
      }, 470);
    }

    /* =========================================================
       盲盒：已打开礼物锁定；仅 Restart Game 可重开
       ========================================================= */
    let currentStep = 1;
    let chances = 3;
    const openedBoxes = new Set();

    function updateProgress() {
      document.getElementById("chanceNum").textContent = chances;
      document.getElementById("progressFill").style.width = (chances / 3 * 100) + "%";

      const cards = document.querySelectorAll(".box-card");
      cards.forEach(card => {
        const id = Number(card.dataset.box);
        card.classList.toggle("opened", openedBoxes.has(id));
        card.classList.toggle("locked", chances <= 0 && !openedBoxes.has(id));
        const btn = card.querySelector(".open-btn");
        if (openedBoxes.has(id)) btn.textContent = "OPENED";
        else if (chances <= 0) btn.textContent = "LOCKED";
        else btn.textContent = "OPEN";
      });
    }

    function openBox(boxId) {
      // 同一个礼物一旦打开就不能重复触发。
      if (openedBoxes.has(boxId)) {
        showToast("这个礼物已经打开啦 ✨ Restart Game 后才能重新打开");
        return;
      }

      if (chances <= 0) {
        showToast("3 次机会已经用完，按 Restart Game 才能再玩 🎁");
        return;
      }

      openedBoxes.add(boxId);
      chances -= 1;
      updateProgress();

      const modalOverlay = document.getElementById("modalOverlay");
      const modalContent = document.getElementById("modalContent");

      if (currentStep === 1) {
        modalContent.innerHTML = `
          <div class="modal-icon">🎤</div>
          <div class="modal-title">Birthday Song!</div>
          <div class="modal-copy">A tiny birthday song just for you. Make a wish and enjoy the moment ✨</div>
          <button class="action-btn" translate="no" type="button" onclick="playBirthdaySong()">LISTEN & SING ALONG</button>
        `;
      } else if (currentStep === 2) {
        modalContent.innerHTML = `
          <div class="modal-icon">🧋</div>
          <div class="modal-title">Sweet Treat Gifting</div>
          <div class="form-group">
            <label for="giftSugar">甜度 Sugar Level</label>
            <select id="giftSugar">
              <option value="标准糖">标准糖</option>
              <option value="少糖">少糖</option>
              <option value="半糖">半糖</option>
              <option value="无糖">无糖</option>
            </select>
          </div>
          <div class="form-group">
            <label for="giftIce">冰量 Ice Level</label>
            <select id="giftIce">
              <option value="标准冰">标准冰</option>
              <option value="少冰">少冰</option>
              <option value="微冰">微冰</option>
              <option value="去冰">去冰</option>
            </select>
          </div>
          <div class="form-group">
            <label for="giftAddress">配送地址 Address</label>
            <input id="giftAddress" type="text" autocomplete="street-address" placeholder="请输入配送地址" />
          </div>
          <div class="form-group">
            <label for="giftPhone">电话号码 Phone</label>
            <input id="giftPhone" type="tel" autocomplete="tel" placeholder="请输入手机号" />
          </div>
          <button class="action-btn" translate="no" id="giftSubmitBtn" type="button" onclick="submitGiftForm()">GIFT & SUBMIT</button>
          <button class="secondary-btn" type="button" onclick="closeModal()">CLOSE</button>
        `;
      } else {
        modalContent.innerHTML = `
          <div class="modal-icon">💋</div>
          <div class="modal-title">Birthday Kiss!</div>
          <div class="modal-copy">One click and the whole universe fills with tiny virtual kisses 💫</div>
          <div style="font-size:22px; margin: 8px 0 4px; letter-spacing:6px;">💋 💋 💋</div>
          <button class="action-btn" translate="no" type="button" onclick="sendVirtualKiss()">SEND VIRTUAL KISS ✨</button>
        `;
      }

      currentStep += 1;
      modalOverlay.style.display = "flex";
    }

    function closeModal() {
      document.getElementById("modalOverlay").style.display = "none";
    }

    function overlayClose(event) {
      if (event.target.id === "modalOverlay") closeModal();
    }

    function resetGame() {
      chances = 3;
      currentStep = 1;
      openedBoxes.clear();
      closeModal();
      updateProgress();
      showToast("Restarted ✨ 4 个礼物都可以重新选择");
    }

    /* =========================================================
       Sweet Treat Gifting — Email
       ========================================================= */
    async function submitGiftForm() {
      const sugar = document.getElementById("giftSugar")?.value || "";
      const ice = document.getElementById("giftIce")?.value || "";
      const address = document.getElementById("giftAddress")?.value.trim() || "";
      const phone = document.getElementById("giftPhone")?.value.trim() || "";
      const submitBtn = document.getElementById("giftSubmitBtn");

      if (!address || !phone) {
        showToast("请先填好配送地址和电话号码 💌");
        return;
      }

      if (!GIFT_RECEIVER_EMAIL) {
        showToast("Email 功能已接好逻辑，但还需要填入你的收件邮箱");
        return;
      }

      const payload = {
        _subject: "🎂 Sweet Treat Gifting Submission",
        Sugar_Level: sugar,
        Ice_Level: ice,
        Address: address,
        Phone: phone,
        Submitted_At: new Date().toLocaleString()
      };

      try {
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "SENDING...";
        }

        const form = new FormData();
        Object.entries(payload).forEach(([key, value]) => form.append(key, value));

        // 使用 FormSubmit 的 AJAX 接口。首次使用某邮箱时，该服务可能要求邮箱确认。
        const response = await fetch(`https://formsubmit.co/ajax/${encodeURIComponent(GIFT_RECEIVER_EMAIL)}`, {
          method: "POST",
          headers: { "Accept": "application/json" },
          body: form
        });

        if (!response.ok) throw new Error("Email request failed");

        showToast("资料已经送出 💌");
        setTimeout(closeModal, 700);
      } catch (err) {
        console.error(err);
        showToast("暂时寄不出去，请检查网络或 Email 设置");
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "GIFT & SUBMIT";
        }
      }
    }

    /* =========================================================
       Virtual Kiss：点击后整个画面铺满小型 kiss
       ========================================================= */
    function sendVirtualKiss() {
      closeModal();
      const layer = document.getElementById("kissLayer");
      layer.innerHTML = "";
      layer.style.display = "block";

      const total = Math.min(190, Math.max(125, Math.round(window.innerWidth * window.innerHeight / 7200)));

      for (let i = 0; i < total; i++) {
        const kiss = document.createElement("span");
        kiss.className = "kiss-particle";
        kiss.textContent = "💋";
        kiss.style.left = (Math.random() * 100) + "%";
        kiss.style.top = (Math.random() * 100) + "%";
        kiss.style.setProperty("--kiss-size", (11 + Math.random() * 12) + "px");
        kiss.style.setProperty("--kiss-delay", (Math.random() * 540) + "ms");
        kiss.style.setProperty("--kiss-duration", (2200 + Math.random() * 1500) + "ms");
        kiss.style.setProperty("--kiss-rot", (-20 + Math.random() * 40) + "deg");
        kiss.style.setProperty("--kiss-dx", (-24 + Math.random() * 48) + "px");
        layer.appendChild(kiss);
      }

      showToast("Virtual Kiss sent 💋✨");
      setTimeout(() => {
        layer.style.display = "none";
        layer.innerHTML = "";
      }, 4300);
    }

    let toastTimer;
    function showToast(message) {
      const toast = document.getElementById("toast");
      toast.textContent = message;
      toast.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove("show"), 2500);
    }

    updateProgress();
  
    // Personal birthday recording
    const bgmSong = document.getElementById("bgmSong");
    const myBirthdaySong = document.getElementById("myBirthdaySong");

    function playBirthdaySong(){
        if (typeof bgmSong !== "undefined") {
            bgmSong.pause();
        }

        myBirthdaySong.currentTime = 0;
        myBirthdaySong.play();

        myBirthdaySong.onended = function(){
            if (typeof bgmSong !== "undefined") {
                bgmSong.play().catch(()=>{});
            }
        };
    }


    // Background music unlock
    function startBackgroundMusic(){
        try {
            if (typeof bgmSong !== "undefined" && bgmSong) {
                bgmSong.loop = true;
                bgmSong.volume = 0.55;
                bgmSong.play().catch(()=>{});
            }
        } catch(e){}
    }

    document.addEventListener("click", startBackgroundMusic, {once:true});
    document.addEventListener("touchstart", startBackgroundMusic, {once:true});
    document.addEventListener("pointerdown", startBackgroundMusic, {once:true});
    
</script>

<script>
(function(){
    const enterUniverse = document.getElementById("enterUniverse");

    function startUniverse(){
        if(!enterUniverse) return;

        enterUniverse.style.transition = "opacity .5s ease";
        enterUniverse.style.opacity = "0";
        enterUniverse.style.pointerEvents = "none";

        setTimeout(function(){
            enterUniverse.remove();

            // continue the existing birthday animation if available
            const view1 = document.getElementById("view1");
            if(view1){
                view1.classList.remove("hidden");
            }

            // start background music
            const music = document.getElementById("bgmSong") || document.getElementById("bgm");
            if(music){
                music.loop = true;
                music.volume = 0.55;
                music.play().catch(()=>{});
            }
        },600);
    }

    if(enterUniverse){
        enterUniverse.onclick = startUniverse;
        enterUniverse.ontouchend = startUniverse;
    }
})();
</script>

